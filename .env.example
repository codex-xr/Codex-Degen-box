# === Telegram Bot (Required) ===
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram User IDs of Admins (e.g., 123456789,987654321)
ADMIN_TELEGRAM_IDS=

# Optional one-time secret code if you don't know your Telegram User ID yet:
# Send `/start YOUR_BOOTSTRAP_CODE` to claim Admin role automatically!
ADMIN_BOOTSTRAP_CODE=

# Max members allowed in this cabal instance (default: 10)
MAX_CABAL_USERS=10

# === Cloud Database (Recommended for Render 24/7) ===
# Paste your Supabase Session Pooler connection string (IPv4) to store each
# user's private vault inside their own separate Postgres schema.
# Leave blank to run with local per-user SQLite files inside DATA_DIR.
DATABASE_URL=

# === Local Fallback Storage (used when DATABASE_URL is empty) ===
DATA_DIR=./data

# === Solana (Recommended: free Helius API key for instant wallet watching!) ===
HELIUS_API_KEY=
# Optional overrides (auto-filled from HELIUS_API_KEY if omitted):
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional Webhook HTTP listener / Health Port:
WEBHOOK_PORT=8787
HELIUS_WEBHOOK_SECRET=

# Optional Alchemy key (great for deep Base 7-day Detective history & Ethereum RPC):
ALCHEMY_API_KEY=

# === Ethereum Mainnet (Chain ID: 1) ===
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# === Base (Chain ID: 8453) ===
BASE_RPC_URL=https://mainnet.base.org
BASE_WS_URL=wss://base-rpc.publicnode.com

# === Robinhood Chain (Chain ID: 4663) ===
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_FALLBACK_RPC_URL=https://robinhood-mainnet.gateway.tatum.io
ROBINHOOD_WS_URL=wss://feed.mainnet.chain.robinhood.com

# === Optional Market & AI Enhancements ===
BIRDEYE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# === Background Engine Intervals ===
ORDER_POLL_MS=5000
EVM_POLL_MS=2500
SOLANA_FALLBACK_POLL_MS=5000

# === Weekly Alpha Report Schedule (UTC) ===
# 0 = Sunday, 1 = Monday ... 6 = Saturday
WEEKLY_REPORT_DAY_UTC=0
WEEKLY_REPORT_HOUR_UTC=18
